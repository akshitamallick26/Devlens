APP_NAME=devlens-api
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://devlens:devlens@localhost:5432/devlens
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# Optional — Impact Intelligence's AI explanation layer. Leave AI_API_KEY
# unset to run with deterministic-only Impact Analysis; nothing else in
# DevLens requires it. See docs/architecture/impact-intelligence.md.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_API_KEY=

# Optional — RAG embeddings (a separate vendor key; Anthropic has no
# embeddings API). Leave EMBEDDING_API_KEY unset to run with lexical-only
# retrieval; deterministic chunking/retrieval never require it.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
