APP_NAME=devlens-api
ENVIRONMENT=development

# Deployment safety: see docs/architecture/deployment-safety.md.
# If DEPLOYMENT_MODE is unset the API runs as public_demo (AI off, generated-
# test execution impossible, rate limiting on). This file is the local
# development template, so it opts out explicitly. For a public deployment
# use DEPLOYMENT_MODE=public_demo (or leave it unset) and see the
# "Public demo" block at the end of this file.
DEPLOYMENT_MODE=development
# development only: runs model-generated pytest code as a subprocess on this
# machine, with no OS-level isolation (app/testing/sandbox.py). Opt-in.
# Rejected at startup when DEPLOYMENT_MODE=public_demo.
TEST_EXECUTION_ENABLED=false

DATABASE_URL=postgresql+psycopg://devlens:devlens@localhost:5432/devlens
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# Optional — Impact Intelligence's AI explanation layer. Leave AI_API_KEY
# unset to run with deterministic-only Impact Analysis; nothing else in
# DevLens requires it. See docs/architecture/impact-intelligence.md.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
AI_API_KEY=

# Optional — RAG embeddings (a separate vendor key; Anthropic has no
# embeddings API). Leave EMBEDDING_API_KEY unset to run with lexical-only
# retrieval; deterministic chunking/retrieval never require it.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# ---- Public demo ----------------------------------------------------------
# DEPLOYMENT_MODE=public_demo
# AI features (both keys above) stay off unless this is true, even when a key
# is set. The API has no authentication: enabling it lets any visitor spend
# provider credit, bounded only by the analysis rate limit below.
# PUBLIC_DEMO_AI_ENABLED=false
#
# Rate limiting: always on in public_demo (RATE_LIMIT_ENABLED=false is a
# startup error there); off in development unless RATE_LIMIT_ENABLED=true.
# One sliding window; each bucket has a per-client and a global ceiling.
# Buckets: ingest = POST /repositories/ingest; pipeline = revision analyze
# and automation analyze; analysis = impact, Q&A, test generation,
# documentation generation and security analysis; session = every
# investigation-session write (create, update, message, add/remove context).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=3600
# RATE_LIMIT_INGEST_PER_CLIENT=5
# RATE_LIMIT_INGEST_GLOBAL=30
# RATE_LIMIT_PIPELINE_PER_CLIENT=10
# RATE_LIMIT_PIPELINE_GLOBAL=60
# RATE_LIMIT_ANALYSIS_PER_CLIENT=60
# RATE_LIMIT_ANALYSIS_GLOBAL=600
# RATE_LIMIT_SESSION_PER_CLIENT=120
# RATE_LIMIT_SESSION_GLOBAL=1200
#
# Ingestion limits (existing settings; must be positive). The defaults allow
# repositories up to 20,000 files / 200 MB, stored in Postgres. On a small
# managed database, lower them, for example:
# INGESTION_MAX_FILES=5000
# INGESTION_MAX_TOTAL_BYTES=50000000
# INGESTION_CLONE_TIMEOUT_SECONDS=60
